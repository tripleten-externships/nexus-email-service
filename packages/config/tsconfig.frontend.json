{
  "extends": "../config/tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@nexus-email/components/ui/*": ["../../packages/components/ui/src/*"],
      "@nexus-email/components/*": ["../../packages/components/src/*"],
      "@nexus-email/lib/*": ["../../packages/lib/src/*"],
      "@nexus-email/*": ["../../packages/*/src"]
    },
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react-jsx"
  },
  "include": ["src", "app"]
}
