{
  "compilerOptions": {
    "target": "ES2020",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      //Top four for Shadcn component imports
      "@nexus-email/components/ui/*": ["../../packages/components/ui/*"],
      "@nexus-email/components/*": ["../../packages/components/*"],
      "@nexus-email/lib/*": ["../../packages/lib/src/*"],
      "@nexus-email/*": ["../../packages/*/src"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next", "coverage"]
}
